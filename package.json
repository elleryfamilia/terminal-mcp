{
  "name": "@ellery/terminal-mcp",
  "version": "0.6.0",
  "description": "A headless terminal emulator exposed via MCP for AI assistants",
  "author": "Ellery Familia",
  "repository": {
    "type": "git",
    "url": "https://github.com/elleryfamilia/terminal-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/elleryfamilia/terminal-mcp/issues"
  },
  "homepage": "https://github.com/elleryfamilia/terminal-mcp#readme",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "terminal-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "logo.png",
    "sandbox-permissions.png",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build",
    "test": "npm run build && node test/run.mjs",
    "test:unit": "npm run build && node --test test/tool-schemas.test.mjs test/sandbox-platform.test.mjs test/quote-shell-arg.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.83",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.2.0-beta.18",
    "smol-toml": "^1.9.1",
    "update-notifier": "^7.3.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/update-notifier": "^6.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "mcp",
    "terminal",
    "pty",
    "xterm",
    "ai",
    "claude"
  ],
  "license": "MIT"
}
